{
  "schema": "moat.conformance.policy_case.v1",
  "name": "safety-beats-tailnet-allow",
  "description": "Same for the controller tailnet address.",
  "policy": "../../policies/home.toml",
  "flow": {
    "id": "c",
    "device_id": "mbp-m1",
    "user": "robert",
    "app": {
      "family": "python3",
      "executable": "/usr/bin/python3"
    },
    "ancestry_complete": true,
    "remote_ip": "100.100.1.2",
    "remote_port": 443,
    "transport": "tcp",
    "at": "2026-10-26T12:00:00Z",
    "session": {
      "id": "sess-1",
      "profile": "private-services-only",
      "boundary": "linux_cgroup",
      "verified": true
    }
  },
  "expect": {
    "verdict": "deny",
    "winner": "rule:safety-workloads-never-reach-controller"
  }
}