{
  "name": "@moat/web",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "VITE_MOAT_DEMO=1 vite build --base=./",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs ../docs/screenshots",
    "build:live": "vite build --outDir build/live",
    "e2e": "node --test --test-concurrency=1 e2e/*.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.10.2",
    "playwright": "^1.48.2",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
