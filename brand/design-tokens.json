{
  "$schema-note": "Moat design tokens. Source of truth for web/src/tokens.css (generated), the macOS colour sets in macos/Moat/App/Assets.xcassets (generated) and macos/MoatKit/Sources/MoatUI/Theme.swift (kept in sync; web/src/tokens.test.ts checks it). Regenerate with: CHROMIUM_PATH=... node web/scripts/brand.mjs",
  "font": {
    "sans": "\"Inter Variable\", \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace",
    "features": "\"cv11\", \"ss01\", \"ss03\"",
    "numerals": "tabular-nums for every figure"
  },
  "type": {
    "note": "One type scale for web (--t-*) and macOS (TypeScale.*). Roles: xs chips and fine print, sm secondary text and labels, md body and card titles, lg section headers, xl detail titles, 2xl page titles on phones, 3xl page titles on desktop and big figures.",
    "xs": 12,
    "sm": 13,
    "md": 15,
    "lg": 17,
    "xl": 20,
    "2xl": 28,
    "3xl": 34
  },
  "weight": {
    "regular": 450,
    "medium": 560,
    "semibold": 640,
    "bold": 700
  },
  "radius": {
    "card": 14,
    "inner": 10,
    "control": 10,
    "chip": 999
  },
  "space": {
    "note": "One spacing scale for padding, margins and gaps on web (--s-*) and macOS (Space.*). Nothing outside it.",
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40
  },
  "hit-target": 44,
  "color": {
    "light": {
      "bg": "#F3F4F8",
      "surface": "#FFFFFF",
      "surface-2": "#F7F8FB",
      "surface-3": "#EDEFF5",
      "border": "#E3E6EE",
      "border-strong": "#CDD2DE",
      "text": "#0F1222",
      "text-2": "#3A4055",
      "muted": "#5D6478",
      "accent": "#4F46E5",
      "accent-strong": "#4F46E5",
      "accent-ink": "#FFFFFF",
      "accent-soft": "#EEF0FF",
      "chart-1": "#8B8FF7",
      "chart-2": "#5CC8B4",
      "chart-3": "#F5B83D",
      "teal": "#115E59",
      "green": "#166534",
      "red": "#B91C1C",
      "amber": "#92400E",
      "violet": "#5B21B6",
      "blue": "#1D4ED8",
      "neutral": "#5D6478"
    },
    "dark": {
      "bg": "#0C0E14",
      "surface": "#151821",
      "surface-2": "#1A1E29",
      "surface-3": "#222734",
      "border": "#252A37",
      "border-strong": "#353B4B",
      "text": "#ECEEF5",
      "text-2": "#C3C8D6",
      "muted": "#969DB0",
      "accent": "#A5A8FF",
      "accent-strong": "#4F4FDC",
      "accent-ink": "#0C0E14",
      "accent-soft": "#23264A",
      "chart-1": "#7C80F0",
      "chart-2": "#3FBFA9",
      "chart-3": "#E9A93A",
      "teal": "#5EEAD4",
      "green": "#4ADE80",
      "red": "#FF8A80",
      "amber": "#F5B84B",
      "violet": "#C4B5FD",
      "blue": "#93B4FF",
      "neutral": "#A1A8B8"
    }
  },
  "contrast": {
    "note": "Increased-contrast overrides (prefers-contrast: more); macOS uses the system's own increased contrast.",
    "light": {
      "muted": "#3C4354",
      "text-2": "#1F2433",
      "border": "#9AA1B2",
      "border-strong": "#6B7285"
    },
    "dark": {
      "muted": "#C3C8D6",
      "text-2": "#E3E6EE",
      "border": "#5A6175",
      "border-strong": "#7B8299"
    }
  },
  "status": {
    "note": "Status is never colour alone: every tone pairs an icon with a label.",
    "green": {
      "icon": "check",
      "sf": "checkmark.circle.fill"
    },
    "blue": {
      "icon": "shield",
      "sf": "shield.fill"
    },
    "violet": {
      "icon": "globe",
      "sf": "globe"
    },
    "amber": {
      "icon": "alert",
      "sf": "exclamationmark.triangle.fill"
    },
    "red": {
      "icon": "x",
      "sf": "xmark.octagon.fill"
    },
    "neutral": {
      "icon": "help",
      "sf": "questionmark.circle"
    }
  }
}
