{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/robzilla1738/moat/contracts/schemas/moat.receipt.v1.schema.json",
  "title": "moat.receipt.v1",
  "description": "Endpoint statement of activation state at one observation time. Consumers compute freshness from observed_at and clock.uncertainty_ms; health_label is display only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activation",
    "boot_id",
    "clock",
    "device_id",
    "monotonic_ms",
    "observed_at",
    "producer",
    "receipt_id",
    "schema",
    "sequence"
  ],
  "properties": {
    "schema": {
      "const": "moat.receipt.v1"
    },
    "receipt_id": {
      "type": "string",
      "description": "[A-Za-z0-9-_.:@/]{1,128}"
    },
    "device_id": {
      "type": "string",
      "description": "[A-Za-z0-9-_.:@/]{1,128}"
    },
    "boot_id": {
      "type": "string",
      "description": "[A-Za-z0-9-_.:@/]{1,128}"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "producer": {
      "type": "string",
      "description": "[A-Za-z0-9-_.:@/]{1,128}"
    },
    "observed_at": {
      "type": "string",
      "description": "canonical UTC timestamp YYYY-MM-DDTHH:MM:SSZ"
    },
    "monotonic_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "uncertainty_ms"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "synchronized",
            "unknown",
            "unsynchronized"
          ]
        },
        "uncertainty_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_generation",
        "durability",
        "phase",
        "replay_high_water"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "none",
            "prepared",
            "applying",
            "trial",
            "confirmed",
            "rollback_required",
            "restored",
            "recovery_required",
            "rejected"
          ]
        },
        "active": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "effective_digest",
            "revision"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "effective_digest": {
              "type": "string",
              "description": "sha256: + 64 lowercase hex"
            }
          }
        },
        "replay_high_water": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "capability_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durability": {
          "type": "string",
          "enum": [
            "durable",
            "not_durable",
            "uncertain"
          ]
        }
      }
    },
    "health_label": {
      "type": "string"
    }
  }
}
